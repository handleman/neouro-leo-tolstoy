# Copy to .env and adjust. Every key is read by tolstoy/config.py;
# tests assert this file stays in sync with KNOWN_ENV_KEYS.

# API surface
TOLSTOY_API_HOST=127.0.0.1
TOLSTOY_API_PORT=8000
TOLSTOY_API_URL=http://127.0.0.1:8000
# CORS allowlist for the future web UI / service (default deny-with-localhost)
TOLSTOY_CORS_ORIGINS=http://localhost:3000

# Vector memory (sole v1 collection)
TOLSTOY_CHROMA_DIR=.chroma
TOLSTOY_COLLECTION=tolstoy-ru
TOLSTOY_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Generator (Ollama today; hosted endpoint tomorrow via URL + key env)
TOLSTOY_OLLAMA_URL=http://localhost:11434
TOLSTOY_OLLAMA_MODEL=llama3.2:1b
TOLSTOY_TEMPERATURE=0.3
TOLSTOY_NUM_PREDICT=1024
TOLSTOY_REPEAT_PENALTY=1.2
TOLSTOY_GENERATOR_TIMEOUT=60

# Retrieval / chunking
TOLSTOY_TOP_K=4
TOLSTOY_CHUNK_SIZE=900
TOLSTOY_CHUNK_OVERLAP=150
TOLSTOY_CHUNK_MIN_CHARS=50
TOLSTOY_SCORE_THRESHOLD=0.55
TOLSTOY_RERANK_BROAD_K=12
TOLSTOY_RERANK_FINAL_K=4
TOLSTOY_RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
TOLSTOY_RERANK_BATCH=32
TOLSTOY_MULTIQUERY_VARIANTS=3
TOLSTOY_MULTIQUERY_K=4
TOLSTOY_RRF_K=60

# Chat language default (ru; en = translation of RU-grounded answer)
TOLSTOY_DEFAULT_LANG=ru
TOLSTOY_CHAT_CONTEXT_CHARS=6000
